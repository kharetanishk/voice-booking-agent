# Required: speech to text and the voice. https://console.deepgram.com
DEEPGRAM_API_KEY=

# Brain, option 1 (used in production): Gemini on Vertex AI, billed to a Google Cloud project.
# The key file belongs to a service account with roles/aiplatform.user.
VERTEX_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional, comma separated, tried in order
# VERTEX_MODEL=google/gemini-3.5-flash-lite,google/gemini-3.1-flash-lite

# Brain, option 2: OpenRouter. Free models, comma separated, tried in order.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,inclusionai/ling-3.0-flash-sante:free,cohere/north-mini-code:free

# PORT=3000
